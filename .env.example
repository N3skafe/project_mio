# PHASE 1 예시. 실제 비밀 값을 넣지 않는다.
# 이 파일을 복사해 .env로 쓸 수 있다. 이미 설정된 환경 변수가 우선한다.
# DEMO는 MAIDOPS_BACKEND_URL에 접속하지 않는다.
# LIVE는 이 주소의 /api/v1/health를 확인한 뒤 작업을 저장한다.
# Compose의 데이터베이스 비밀번호 maidops는 로컬 전용 기본값이다.

MAIDOPS_MODE=DEMO
MAIDOPS_BACKEND_URL=http://127.0.0.1:8080
MAIDOPS_CHARACTER_NAME=미오
MAIDOPS_QUIET=false
MAIDOPS_LOG_LIMIT=200
MAIDOPS_DEMO_DELAY_SECONDS=5.0
MAIDOPS_MODEL_DIR=data/models
MAIDOPS_TRAIN_DEVICE=auto
MAIDOPS_CODE_ROOT=.
